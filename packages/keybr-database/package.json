{
  "private": true,
  "name": "@keybr/database",
  "version": "0.0.0",
  "type": "module",
  "main": "lib/index.ts",
  "types": ".types/index.d.ts",
  "dependencies": {
    "@keybr/config": "workspace:*",
    "@keybr/names": "workspace:*",
    "@keybr/pages-shared": "workspace:*",
    "@keybr/publicid": "workspace:*",
    "@keybr/rand": "workspace:*"
  },
  "devDependencies": {},
  "scripts": {
    "clean": "rm -fr .types",
    "compile": "tsc",
    "test": "tstest --import=@keybr/test-env-server --test --test-concurrency=1 'lib/**/*.test.{ts,tsx}'",
    "fast-test": "env DATABASE_CLIENT=sqlite tstest --import=@keybr/test-env-server --test 'lib/**/*.test.{ts,tsx}'"
  }
}
