{
  "private": true,
  "name": "@keybr/server",
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@keybr/assets": "workspace:*",
    "@keybr/config": "workspace:*",
    "@keybr/database": "workspace:*",
    "@keybr/intl": "workspace:*",
    "@keybr/logger": "workspace:*",
    "@keybr/pages-server": "workspace:*",
    "@keybr/pages-shared": "workspace:*",
    "@keybr/publicid": "workspace:*",
    "@keybr/result": "workspace:*",
    "@keybr/result-io": "workspace:*",
    "@keybr/result-userdata": "workspace:*",
    "@keybr/settings": "workspace:*",
    "@keybr/settings-database": "workspace:*",
    "@keybr/themes": "workspace:*"
  },
  "devDependencies": {},
  "scripts": {
    "clean": "rm -fr .types",
    "compile": "tsc",
    "test": "tstest --import=@keybr/test-env-server --import=@keybr/test-env-bundler --test --test-concurrency=1 'lib/**/*.test.{ts,tsx}'",
    "fast-test": "env DATABASE_CLIENT=sqlite tstest --import=@keybr/test-env-server --import=@keybr/test-env-bundler --test 'lib/**/*.test.{ts,tsx}'"
  }
}
